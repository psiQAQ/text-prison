{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextPrison experiment record v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "scenario_id",
    "track",
    "arm",
    "phase",
    "host",
    "model",
    "profile",
    "language",
    "status",
    "assignment_id",
    "attempt_id",
    "retry_of",
    "cost_scope",
    "usage",
    "artifact_refs",
    "review_refs",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "track": {
      "enum": [
        "smoke",
        "calibration",
        "product_native",
        "controlled",
        "feedback_ablation",
        "trigger",
        "legacy"
      ]
    },
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "smoke",
        "writer",
        "executor",
        "reader",
        "trigger",
        "judge",
        "unknown"
      ]
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "host_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "repeat": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "enum": [
        "explanation",
        "procedure",
        "reference",
        "research",
        "agent-spec",
        "structured"
      ]
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout",
        "blocked",
        "not_run",
        "interrupted"
      ]
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost_scope": {
      "enum": [
        "production_writer",
        "downstream_executor",
        "evaluation_only",
        "unknown"
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "coverage",
        "input_total",
        "output_total",
        "raw_log"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "input_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_cached": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_cache_write": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_reasoning": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "raw_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pricing_snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "rule_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "reviewer_id",
          "path",
          "sha256"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "object",
      "required": [
        "semantic_status",
        "agent_success",
        "trigger_observed"
      ],
      "properties": {
        "semantic_status": {
          "enum": [
            "passed",
            "failed",
            "uncertain",
            "not_evaluated"
          ]
        },
        "agent_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "trigger_observed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "critical_errors": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mechanical_errors": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    },
    "legacy_original": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "not": {
              "const": "legacy"
            }
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "not": {
              "const": "unknown"
            }
          },
          "cost_scope": {
            "not": {
              "const": "unknown"
            }
          }
        }
      }
    }
  ]
}
